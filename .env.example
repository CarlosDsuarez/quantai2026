# Clave de Anthropic para el extractor LLM (src/extraction/)
ANTHROPIC_API_KEY=

# Perfil persistente de Chromium (RECOMENDADO). Bootstrap una vez con:
#   python src/ingestion/bloomberg_scraper.py --profile-dir config/browser_profile --login
# (el login lo haces TU a mano en la ventana; la sesion se refresca sola despues)
BLOOMBERG_PROFILE_DIR=config/browser_profile

# LEGACY: ruta al JSON de cookies de Bloomberg exportadas MANUALMENTE desde tu
# navegador logueado (extension Cookie-Editor -> Export JSON).
# OJO: el token de sesion caduca en ~45 min desde el export; solo para corridas
# cortas e inmediatas. El scraper NUNCA hace login ni genera cookies.
BLOOMBERG_COOKIES_FILE=config/bloomberg_cookies.json

# Delay minimo entre requests del scraper (segundos, >= 2.0)
SCRAPER_MIN_DELAY_SECONDS=2.5
